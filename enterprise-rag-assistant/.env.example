# Free key from https://console.groq.com/keys
GROQ_API_KEY=PASTE_API
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Fully offline alternative (no key, needs `ollama pull llama3.1:8b`)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b

# Retrieval knobs -- these are what the sweep varies
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
CANDIDATE_K=20
USE_HYBRID=true
USE_RERANKER=true
MIN_SCORE=0.25

# Leave QDRANT_URL unset to use the embedded local store (no Docker needed)
# QDRANT_URL=http://localhost:6333
